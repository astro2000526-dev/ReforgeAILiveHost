# --- Supabase ---
# Project URL + anon key (safe to ship to browser, behind RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. Server-side only. NEVER prefix with
# NEXT_PUBLIC_, it will leak into the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pipeline (GPU service) ---
# Public HTTPS URL of the FastAPI pipeline service on UCloud GPU.
# In dev pointing at localhost is fine: http://localhost:8000
PIPELINE_API_URL=

# Shared secret. Must match services/pipeline/.env PIPELINE_TOKEN exactly.
# Generate with:  openssl rand -base64 48
# Server-side only (NEVER NEXT_PUBLIC_).
PIPELINE_TOKEN=
