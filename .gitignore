# Python
__pycache__/
*.py[cod]
*$py.class
# Un-ignore __init__.py — the user-global gitignore has `_*` which would
# silently drop every package marker (bit us on the UCloud deploy before).
!__init__.py
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project: runtime artifacts (generated videos, downloaded templates, tmp)
services/pipeline/tmp/
services/pipeline/cache/
services/pipeline/output/

# Local binaries (e.g. ffmpeg static build for Windows dev)
tools/

# Personal test assets (large media you tried locally; don't ship)
testvideo.mp4
*.local.mp4

# TypeScript incremental build cache
*.tsbuildinfo

# Secrets
.env
*.pem
*.key

# Kasidit privacy guard (kasi-init step 11)
.kasidit/knowledge/*.private.md
.kasidit/config.json
# Do NOT commit ~/.claude/skills/kasidit/center/logs/ anywhere — contains prompts.
.claude