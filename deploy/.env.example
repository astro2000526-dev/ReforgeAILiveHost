# ── Reforge deploy config ────────────────────────────────────────────────────
# Copy is created automatically by init.sh; you normally don't edit this by hand.
# Anything left blank below is auto-generated/auto-detected on first `init.sh`.

# Public IPv4 of THIS server — used for the nip.io URLs (console/api/status).
# Leave blank to auto-detect.
HOST_IP=

# Where ALL persistent data lives (Postgres, models ~700MB, rendered mp4s,
# ollama ~2GB). Needs ~15GB free for a comfortable first run.
DATA_DIR=/data/reforge

# HuggingFace mirror. China: https://hf-mirror.com  •  elsewhere: https://huggingface.co
HF_MIRROR=https://hf-mirror.com

# Lip-sync engine: wav2lip (default — fast, light, ~500MB weights) |
# musetalk (higher quality but heavy + slow; init.sh downloads the ~6GB weight
# set and the container runs with PYTORCH_JIT=0).
LIPSYNC_MODEL=wav2lip

# ── HTTPS + Google login (opt-in — see deploy/HTTPS_OAUTH.md) ────────────────
# Real domain for TLS. Leave blank to stay on the nip.io HTTP flow. When set and
# scripts/enable-https.sh has run, the stack serves https://console.<DOMAIN> etc.
DOMAIN=
# Google OAuth login. 0 = demo mode (no login, uses the fixed demo user).
# Set to 1 ONLY when NEXT_PUBLIC_SUPABASE_URL/ANON_KEY point at Supabase CLOUD.
# Inlined at web BUILD time → rebuild the web image after changing.
NEXT_PUBLIC_AUTH_ENABLED=0

# ── API keys are NOT set here ────────────────────────────────────────────────
# Azure Speech (and any other provider key) is entered in the app UI:
#   Console → Settings → Text-to-Speech → Azure Neural → paste key.
# It is stored in the DB (system_config) and passed to the pipeline per render.
# Only infra secrets below are auto-generated by init.sh.

# ── Secrets — auto-generated by init.sh if blank. Keep them out of git. ──────
JWT_SECRET=
ANON_KEY=
SERVICE_KEY=
PIPELINE_TOKEN=
SUPERPASS=
AUTHPASS=
