FFMPEG_BIN=ffmpeg

# Set to 1 on the RunPod GPU box where MuseTalk is installed.
MUSETALK_ENABLED=0

# TTS provider: "azure" (default, recommended) | "volcengine" | "edge"
TTS_PROVIDER=azure

# --- Azure Speech ---
# portal.azure.com → create "Speech service" → "Keys and Endpoint" tab.
# Region: southeastasia (Singapore) is closest for TH/ID/VN markets.
# SEA voices: th-TH-PremwadeeNeural, id-ID-GadisNeural, vi-VN-HoaiMyNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional: override output format. Default is 24kHz 48kbps mono mp3.
AZURE_SPEECH_FORMAT=

# --- Volcengine (fallback) ---
# console.volcengine.com → 豆包语音 → 应用管理 (legacy app id + access token)
# Note: Thai language requires a separate ¥1000/month subscription on this account.
VOLCENGINE_APPID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_CLUSTER=volcano_tts
VOLCENGINE_ENDPOINT=

# --- Supabase Storage (for uploading generated mp4) ---
# Required for the pipeline to upload finished videos. When blank the pipeline
# still runs and writes to ./output/ — useful for local smoke tests.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Bucket must exist + be set to public-read in Supabase Dashboard → Storage.
SUPABASE_STORAGE_BUCKET=generations
