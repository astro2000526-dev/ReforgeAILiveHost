FFMPEG_BIN=ffmpeg

# --- MuseTalk (RunPod GPU only) ---
# Set MUSETALK_ENABLED=1 on the pod after you've cloned MuseTalk + downloaded
# weights. Local Windows dev leaves it 0 and the pipeline uses a loop+mux fallback.
MUSETALK_ENABLED=0
# Absolute path to the MuseTalk repo root (contains scripts/, configs/, models/).
MUSETALK_PATH=/workspace/MuseTalk
# v15 (default, better) or v1.
MUSETALK_VERSION=v15
# Override if you put weights somewhere non-standard. Defaults work for the
# layout produced by MuseTalk's `download_weights.sh`.
MUSETALK_UNET_MODEL=
MUSETALK_UNET_CONFIG=
# Directory CONTAINING the ffmpeg binary (NOT the binary path itself). On most
# RunPod images this is /usr/bin. Leave blank to omit the --ffmpeg_path flag.
MUSETALK_FFMPEG_DIR=/usr/bin
# Optional: separate python for MuseTalk if its deps don't coexist with the
# FastAPI service's. Defaults to the same python running uvicorn.
MUSETALK_PYTHON=

# --- GFPGAN face restoration (cleans up MuseTalk's mouth-edge artifacts) ---
# Toggle: 1 on the GPU pod after weights downloaded; 0 for local dev / fast jobs.
# Adds ~30-60s per 30s of generated video on a 4090.
GFPGAN_ENABLED=0
# Optional override for the weight file path. Default: MuseTalk/gfpgan_weights/GFPGANv1.4.pth
GFPGAN_WEIGHT=

# TTS provider: "azure" (default, recommended) | "volcengine" | "edge"
TTS_PROVIDER=azure

# --- Azure Speech ---
# portal.azure.com → create "Speech service" → "Keys and Endpoint" tab.
# Region: southeastasia (Singapore) is closest for TH/ID/VN markets.
# SEA voices: th-TH-PremwadeeNeural, id-ID-GadisNeural, vi-VN-HoaiMyNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional: override output format. Default is 24kHz 48kbps mono mp3.
AZURE_SPEECH_FORMAT=

# --- Volcengine (fallback) ---
# console.volcengine.com → 豆包语音 → 应用管理 (legacy app id + access token)
# Note: Thai language requires a separate ¥1000/month subscription on this account.
VOLCENGINE_APPID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_CLUSTER=volcano_tts
VOLCENGINE_ENDPOINT=

# --- Supabase Storage (for uploading generated mp4) ---
# Required for the pipeline to upload finished videos. When blank the pipeline
# still runs and writes to ./output/ — useful for local smoke tests.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Bucket must exist + be set to public-read in Supabase Dashboard → Storage.
SUPABASE_STORAGE_BUCKET=generations
